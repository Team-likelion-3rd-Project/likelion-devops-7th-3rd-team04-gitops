{
  "uid": "team04-api-grpc",
  "title": "team04 / API · gRPC 상세",
  "description": "HTTP 라우트 · gRPC 메서드 단위 요청 · 지연 · 결과 코드와 서비스 간 호출 관계 (backend libs/common metrics, infra/ansible README 17절)",
  "tags": [
    "team04"
  ],
  "timezone": "",
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "데이터소스",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      },
      {
        "name": "cluster",
        "label": "cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(nodejs_version_info, cluster)",
          "refId": "cluster"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {}
      },
      {
        "name": "service",
        "label": "서비스",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(nodejs_version_info{cluster=~\"$cluster\"}, service)",
          "refId": "service"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {}
      },
      {
        "name": "rpc_service",
        "label": "gRPC 서비스",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(rpc_server_duration_seconds_count{cluster=~\"$cluster\", service=~\"$service\"}, rpc_service)",
          "refId": "rpc_service"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "HTTP",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "라우트별 요청 수 (상위 10)",
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (service, http_method, http_route) (rate(http_server_request_duration_seconds_count{cluster=~\"$cluster\", service=~\"$service\"}[$__rate_interval])))",
          "legendFormat": "{{http_method}} {{http_route}} ({{service}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 2,
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "timeseries",
      "title": "상태 코드별 요청 수",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (http_status_code) (rate(http_server_request_duration_seconds_count{cluster=~\"$cluster\", service=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{http_status_code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "fillOpacity": 30
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "5xx 만 에러로 셈 (합의). 401 · 403 · 429 는 가드, unmatched 404 는 없는 경로",
      "id": 3,
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "table",
      "title": "라우트별 요청 · 지연 · 5xx (선택 기간)",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service, http_method, http_route) (rate(http_server_request_duration_seconds_count{cluster=~\"$cluster\", service=~\"$service\"}[$__range]))",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, service, http_method, http_route) (rate(http_server_request_duration_seconds_bucket{cluster=~\"$cluster\", service=~\"$service\"}[$__range])))",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le, service, http_method, http_route) (rate(http_server_request_duration_seconds_bucket{cluster=~\"$cluster\", service=~\"$service\"}[$__range])))",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "D",
          "expr": "sum by (service, http_method, http_route) (rate(http_server_request_duration_seconds_count{cluster=~\"$cluster\", service=~\"$service\", http_status_code=~\"5..\"}[$__range])) / sum by (service, http_method, http_route) (rate(http_server_request_duration_seconds_count{cluster=~\"$cluster\", service=~\"$service\"}[$__range]))",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "요청 수",
              "Value #B": "p95",
              "Value #C": "p99",
              "Value #D": "5xx 비율"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value #A"
            },
            "properties": [
              {
                "id": "unit",
                "value": "reqps"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #B"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #C"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #D"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      },
      "description": "화면 오른쪽 위에서 고른 기간 전체 기준. 열 제목을 눌러 정렬",
      "id": 4,
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "id": 5,
      "type": "row",
      "title": "gRPC 서버 (받은 호출)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "메서드별 요청 수 (상위 10)",
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (rpc_service, rpc_method) (rate(rpc_server_duration_seconds_count{cluster=~\"$cluster\", service=~\"$service\", rpc_service=~\"$rpc_service\"}[$__rate_interval])))",
          "legendFormat": "{{rpc_service}}/{{rpc_method}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 6,
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "timeseries",
      "title": "결과 코드별 요청 수",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (grpc_code) (rate(rpc_server_duration_seconds_count{cluster=~\"$cluster\", service=~\"$service\", rpc_service=~\"$rpc_service\"}[$__rate_interval]))",
          "legendFormat": "{{grpc_code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "fillOpacity": 30
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "NOT_FOUND · INVALID_ARGUMENT 등은 비즈니스 거절, INTERNAL · UNAVAILABLE 등은 서버 오류 (LDP-167)",
      "id": 7,
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 21
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "table",
      "title": "메서드별 요청 · 지연 · 결과 (선택 기간)",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service, rpc_service, rpc_method) (rate(rpc_server_duration_seconds_count{cluster=~\"$cluster\", service=~\"$service\", rpc_service=~\"$rpc_service\"}[$__range]))",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, service, rpc_service, rpc_method) (rate(rpc_server_duration_seconds_bucket{cluster=~\"$cluster\", service=~\"$service\", rpc_service=~\"$rpc_service\"}[$__range])))",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "C",
          "expr": "sum by (service, rpc_service, rpc_method) (rate(rpc_server_duration_seconds_count{cluster=~\"$cluster\", service=~\"$service\", rpc_service=~\"$rpc_service\", grpc_code!=\"OK\"}[$__range])) / sum by (service, rpc_service, rpc_method) (rate(rpc_server_duration_seconds_count{cluster=~\"$cluster\", service=~\"$service\", rpc_service=~\"$rpc_service\"}[$__range]))",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "요청 수",
              "Value #B": "p95",
              "Value #C": "OK 아닌 비율"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value #A"
            },
            "properties": [
              {
                "id": "unit",
                "value": "reqps"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #B"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #C"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      },
      "id": 8,
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 30
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "id": 9,
      "type": "row",
      "title": "서비스 간 호출 (gRPC 클라이언트)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 40
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "호출 관계: 부른 서비스 → 불린 서비스 (선택 기간)",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service, peer_service) (rate(rpc_client_duration_seconds_count{cluster=~\"$cluster\", service=~\"$service\"}[$__range]))",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, service, peer_service) (rate(rpc_client_duration_seconds_bucket{cluster=~\"$cluster\", service=~\"$service\"}[$__range])))",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "C",
          "expr": "sum by (service, peer_service) (rate(rpc_client_duration_seconds_count{cluster=~\"$cluster\", service=~\"$service\", grpc_code=~\"UNAVAILABLE|DEADLINE_EXCEEDED\"}[$__range])) / sum by (service, peer_service) (rate(rpc_client_duration_seconds_count{cluster=~\"$cluster\", service=~\"$service\"}[$__range]))",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "service": "부른 서비스",
              "peer_service": "불린 서비스",
              "Value #A": "요청 수",
              "Value #B": "p95",
              "Value #C": "연결 실패 · 시간 초과 비율"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value #A"
            },
            "properties": [
              {
                "id": "unit",
                "value": "reqps"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #B"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #C"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      },
      "description": "부른 쪽에서 잰 지연(네트워크 포함). 같은 메서드의 서버 p95 보다 크게 길면 네트워크 · 연결 문제. 연결 실패 비율 = UNAVAILABLE · DEADLINE_EXCEEDED",
      "id": 10,
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 41
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "timeseries",
      "title": "호출 p95 지연 (부른 쪽 기준)",
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, service, peer_service) (rate(rpc_client_duration_seconds_bucket{cluster=~\"$cluster\", service=~\"$service\"}[$__rate_interval])))",
          "legendFormat": "{{service}} → {{peer_service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 11,
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 50
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    }
  ]
}
