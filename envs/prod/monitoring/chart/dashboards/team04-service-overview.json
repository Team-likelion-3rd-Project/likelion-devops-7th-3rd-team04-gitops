{
  "uid": "team04-service-overview",
  "title": "team04 / 서비스 개요",
  "description": "서비스별 요청 · 지연 · 에러(HTTP · gRPC)와 CPU · 메모리를 클러스터 · 결제 노드 함께 봅니다. 시작점 대시보드 (infra/ansible README 17절)",
  "tags": [
    "team04"
  ],
  "timezone": "",
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "데이터소스",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      },
      {
        "name": "cluster",
        "label": "cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(container_cpu_usage_seconds_total{namespace=~\"backend|payment\"}, cluster)",
          "refId": "cluster"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {}
      },
      {
        "name": "container",
        "label": "서비스",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(container_cpu_usage_seconds_total{cluster=~\"$cluster\", namespace=~\"backend|payment\", container!=\"\", container!=\"POD\"}, container)",
          "refId": "container"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "HTTP (api-gateway · pg-mock)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "요청 수",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cluster, service) (rate(http_server_request_duration_seconds_count{cluster=~\"$cluster\", service=~\"$container\"}[$__rate_interval]))",
          "legendFormat": "{{service}} [{{cluster}}]"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 2,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "timeseries",
      "title": "p95 지연",
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, cluster, service) (rate(http_server_request_duration_seconds_bucket{cluster=~\"$cluster\", service=~\"$container\"}[$__rate_interval])))",
          "legendFormat": "{{service}} [{{cluster}}]"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 3,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "timeseries",
      "title": "5xx 비율",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cluster, service) (rate(http_server_request_duration_seconds_count{cluster=~\"$cluster\", service=~\"$container\", http_status_code=~\"5..\"}[$__rate_interval])) / sum by (cluster, service) (rate(http_server_request_duration_seconds_count{cluster=~\"$cluster\", service=~\"$container\"}[$__rate_interval]))",
          "legendFormat": "{{service}} [{{cluster}}]"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "에러 기준(HTTP 5xx). api-gateway 가 5% 를 5분 넘으면 ApiGateway5xxRateHigh 알람",
      "id": 4,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "id": 5,
      "type": "row",
      "title": "gRPC 서버",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "요청 수",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cluster, service) (rate(rpc_server_duration_seconds_count{cluster=~\"$cluster\", service=~\"$container\"}[$__rate_interval]))",
          "legendFormat": "{{service}} [{{cluster}}]"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 6,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "timeseries",
      "title": "p95 지연",
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, cluster, service) (rate(rpc_server_duration_seconds_bucket{cluster=~\"$cluster\", service=~\"$container\"}[$__rate_interval])))",
          "legendFormat": "{{service}} [{{cluster}}]"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 7,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "timeseries",
      "title": "OK 아닌 응답 비율",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cluster, service) (rate(rpc_server_duration_seconds_count{cluster=~\"$cluster\", service=~\"$container\", grpc_code!=\"OK\"}[$__rate_interval])) / sum by (cluster, service) (rate(rpc_server_duration_seconds_count{cluster=~\"$cluster\", service=~\"$container\"}[$__rate_interval]))",
          "legendFormat": "{{service}} [{{cluster}}]"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "NOT_FOUND · INVALID_ARGUMENT 같은 비즈니스 거절도 포함 — 알람 기준 아님. 코드별 분포는 'team04 / API · gRPC 상세'",
      "id": 8,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "id": 9,
      "type": "row",
      "title": "리소스",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "CPU (cores)",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cluster, container) (rate(container_cpu_usage_seconds_total{cluster=~\"$cluster\", namespace=~\"backend|payment\", container=~\"$container\", container!=\"\", container!=\"POD\"}[$__rate_interval]))",
          "legendFormat": "{{container}} [{{cluster}}]"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "클러스터는 Pod 합계, 결제 노드는 컨테이너. container 라벨 = 서비스 이름 (결제 노드는 Alloy 가 Docker 컨테이너 이름을 container 로 맞춤)",
      "id": 10,
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 19
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "timeseries",
      "title": "메모리 (working set)",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cluster, container) (container_memory_working_set_bytes{cluster=~\"$cluster\", namespace=~\"backend|payment\", container=~\"$container\", container!=\"\", container!=\"POD\"})",
          "legendFormat": "{{container}} [{{cluster}}]"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 11,
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 19
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "timeseries",
      "title": "메모리 / limit (클러스터)",
      "targets": [
        {
          "refId": "A",
          "expr": "max by (pod, container) (container_memory_working_set_bytes{cluster=\"main\", namespace=\"backend\", container=~\"$container\", container!=\"\", container!=\"POD\"}) / on (pod, container) max by (pod, container) (kube_pod_container_resource_limits{cluster=\"main\", namespace=\"backend\", container=~\"$container\", resource=\"memory\"})",
          "legendFormat": "{{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Pod 별 working set ÷ memory limit. 90% 를 5분 넘으면 ContainerMemoryNearLimit 알람",
      "id": 12,
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "timeseries",
      "title": "CPU 스로틀링 비율 (클러스터)",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod, container) (rate(container_cpu_cfs_throttled_periods_total{cluster=\"main\", namespace=\"backend\", container=~\"$container\", container!=\"\"}[$__rate_interval])) / sum by (pod, container) (rate(container_cpu_cfs_periods_total{cluster=\"main\", namespace=\"backend\", container=~\"$container\", container!=\"\"}[$__rate_interval]))",
          "legendFormat": "{{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "CPU limit 때문에 멈춘 주기 비율. 25% 를 15분 넘으면 CPUThrottlingHigh 알람",
      "id": 13,
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "timeseries",
      "title": "재시작 횟수 (1시간, 클러스터)",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (container) (increase(kube_pod_container_status_restarts_total{cluster=\"main\", namespace=\"backend\", container=~\"$container\"}[1h]))",
          "legendFormat": "{{container}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 14,
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 37
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    }
  ]
}
