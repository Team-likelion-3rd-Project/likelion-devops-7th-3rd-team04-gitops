    {
      "type": "timeseries",
      "title": "5xx 비율",
      "description": "ALB 가 받은 요청 중 5xx 비율. 대상(Traefik · 앱) 5xx + ALB 자체 5xx(대상 없음 · 응답 없음). 앱이 응답하지 못한 장애도 여기에 잡힌다. 90 알람 main-alb-5xx-rate 와 같은 식",
      "datasource": {
        "type": "cloudwatch",
        "uid": "cloudwatch"
      },
      "targets": [
        {
          "refId": "REQ",
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 1,
          "region": "default",
          "namespace": "",
          "metricName": "",
          "dimensions": {},
          "matchExact": true,
          "statistic": "Sum",
          "period": "60",
          "id": "req",
          "expression": "SUM(SEARCH('{AWS/ApplicationELB,LoadBalancer} MetricName=\"RequestCount\" team04-hotel-main-alb', 'Sum', 60))",
          "label": "요청",
          "hide": true
        },
        {
          "refId": "T5",
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 1,
          "region": "default",
          "namespace": "",
          "metricName": "",
          "dimensions": {},
          "matchExact": true,
          "statistic": "Sum",
          "period": "60",
          "id": "t5",
          "expression": "SUM(SEARCH('{AWS/ApplicationELB,LoadBalancer} MetricName=\"HTTPCode_Target_5XX_Count\" team04-hotel-main-alb', 'Sum', 60))",
          "label": "대상 5xx",
          "hide": true
        },
        {
          "refId": "E5",
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 1,
          "region": "default",
          "namespace": "",
          "metricName": "",
          "dimensions": {},
          "matchExact": true,
          "statistic": "Sum",
          "period": "60",
          "id": "e5",
          "expression": "SUM(SEARCH('{AWS/ApplicationELB,LoadBalancer} MetricName=\"HTTPCode_ELB_5XX_Count\" team04-hotel-main-alb', 'Sum', 60))",
          "label": "ALB 5xx",
          "hide": true
        },
        {
          "refId": "RATE",
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 1,
          "region": "default",
          "namespace": "",
          "metricName": "",
          "dimensions": {},
          "matchExact": true,
          "statistic": "Sum",
          "period": "60",
          "id": "",
          "expression": "IF(FILL(req, 0) > 0, 100 * (FILL(t5, 0) + FILL(e5, 0)) / FILL(req, 1), 0)",
          "label": "5xx 비율",
          "hide": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 5
              }
            ]
