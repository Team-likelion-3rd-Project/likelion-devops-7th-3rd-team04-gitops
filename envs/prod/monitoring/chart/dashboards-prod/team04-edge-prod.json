    {
      "type": "timeseries",
      "title": "응답 코드별 요청/초 (엔트리포인트 web)",
      "description": "백엔드가 없거나(Endpoints 0) 응답하지 못해 Traefik 이 직접 돌려준 502 · 503 도 여기에 잡힌다 (앱 지표에는 없음)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (code) (rate(traefik_entrypoint_requests_total{cluster=\"main\", entrypoint=\"web\"}[$__rate_interval]))",
          "legendFormat": "{{code}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 8,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      }
    },
    {
      "type": "timeseries",
      "title": "5xx 비율 (엔트리포인트 web)",
      "description": "Traefik 이 돌려준 응답 중 5xx 비율. 앱 응답 5xx 와 Traefik 자체 502 · 503 모두 포함",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(traefik_entrypoint_requests_total{cluster=\"main\", entrypoint=\"web\", code=~\"5..\"}[$__rate_interval])) / sum(rate(traefik_entrypoint_requests_total{cluster=\"main\", entrypoint=\"web\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "5xx 비율",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 9,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      }
    },
