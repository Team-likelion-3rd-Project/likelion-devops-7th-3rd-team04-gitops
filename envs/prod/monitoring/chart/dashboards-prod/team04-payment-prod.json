{
  "uid": "team04-payment-prod",
  "title": "team04 / 결제 (prod)",
  "description": "운영 결제 VPC 지표 — 결제 서버 Alloy → AMP(Terraform 10-global metrics.tf, 데이터 소스 AMP (payment)). 메인 Prometheus 에는 없음. 온프레미스 team04-payment-node · team04-db 결제 패널을 옮긴 것 (LDP-181)",
  "tags": [
    "team04",
    "payment",
    "prod"
  ],
  "timezone": "",
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "결제 서버",
        "type": "query",
        "datasource": {
          "type": "grafana-amazonprometheus-datasource",
          "uid": "amp-payment"
        },
        "query": {
          "query": "label_values(up{cluster=\"payment\", job=\"node-exporter\"}, instance)",
          "refId": "instance"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "결제 서버 — 호스트 · 컨테이너 (Alloy unix · cadvisor)",
      "collapsed": false,
      "id": 1,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "수집 상태 (1 = 정상)",
      "description": "Alloy 가 수집한 대상별 up. 값이 없으면 노드 또는 Alloy → remote_write 경로를 확인 (알람 PaymentMetricsAbsent · DbNodeMetricsAbsent)",
      "targets": [
        {
          "refId": "A",
          "expr": "up{cluster=\"payment\", instance=~\"$instance\"}",
          "legendFormat": "{{instance}} / {{job}}",
          "instant": true,
          "datasource": {
            "type": "grafana-amazonprometheus-datasource",
            "uid": "amp-payment"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "id": 2,
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "grafana-amazonprometheus-datasource",
        "uid": "amp-payment"
      }
    },
    {
      "type": "timeseries",
      "title": "호스트 CPU 사용률",
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{cluster=\"payment\", instance=~\"$instance\", mode=\"idle\"}[$__rate_interval])))",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "grafana-amazonprometheus-datasource",
            "uid": "amp-payment"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 3,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
