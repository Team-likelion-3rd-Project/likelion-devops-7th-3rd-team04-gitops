            "type": "grafana-amazonprometheus-datasource",
            "uid": "amp-payment"
          }
        },
        {
          "refId": "C",
          "expr": "max by (instance) (mysql_global_variables_max_connections{cluster=\"payment\", job=\"mysql\"})",
